# Get this from your Supabase project: Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
PORT=4000

# Secret for signing JWT access tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Where the React app runs (CORS origin + redirect after GitHub login)
FRONTEND_URL=http://localhost:5173
# Public URL of this API (used for the GitHub OAuth callback)
API_URL=http://localhost:4000

# Bonus 1 - GitHub OAuth app (github.com/settings/developers)
# Authorization callback URL: http://localhost:4000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
